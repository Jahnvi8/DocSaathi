# ── DocSaathi environment variables ──────────────────────────────
# Copy this file to ".env" (in the project root) and fill in your key.
#
#   cp .env.example .env
#
# Get a FREE Gemini API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
# (Sign in with a Google account → "Create API key" → copy it here.)

# Required: your Gemini API key.
GEMINI_API_KEY=

# Optional: port the Express API listens on (default 3001).
PORT=3001

# Optional: models (safe defaults shown — change only if you know why).
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Optional: how many document chunks to retrieve per question (default 4).
RAG_TOP_K=4

# ── Retrieval pipeline (Track A) ─────────────────────────────────────────────
# Toggle the composable retrieval stages. Hybrid is free (local BM25 + vectors).
# Rewrite and rerank each add ONE Gemini generation call per question — the free
# tier is ~20 generation requests/day, so they default OFF to keep chat usable.
RAG_HYBRID=true            # BM25 + vector search fused with Reciprocal Rank Fusion
RAG_QUERY_REWRITE=false    # LLM expands the question into multiple search queries
RAG_RERANK=false           # LLM reorders a wide candidate pool down to the best few
RAG_CANDIDATE_K=20         # how many candidates to retrieve before reranking

# Contextual retrieval (ingest-time): prepend an LLM-written context blurb to
# each chunk before embedding. Improves recall but costs ONE call per chunk at
# upload time — leave off unless you have quota to spare.
RAG_CONTEXTUAL=false
